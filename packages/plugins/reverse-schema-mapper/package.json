  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "5.0.0",
    "rollup": "4.63.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
