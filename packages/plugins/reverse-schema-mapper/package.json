{
  "name": "@magidoc/plugin-reverse-schema-mapper",
  "description": "A library that provides the ability to do a reverse lookup on GraphQL types.",
  "private": false,
  "version": "7.0.0",
  "type": "module",
  "license": "MIT",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "keywords": [
    "graphql",
    "graphql-schema",
    "node",
    "browser"
  ],
  "homepage": "https://magidoc.js.org/plugins/reverse-schema-mapper",
  "repository": {
    "type": "git",
    "url": "https://github.com/magidoc-org/magidoc.git",
    "directory": "packages/plugins/reverse-schema-mapper"
  },
  "scripts": {
    "build": "run-p build:*",
    "build:rollup": "rollup -c",
