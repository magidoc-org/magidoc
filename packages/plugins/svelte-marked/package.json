{
  "name": "@magidoc/plugin-svelte-marked",
  "description": "A markdown parser library that renders to svelte components.",
  "type": "module",
  "license": "MIT",
  "version": "8.0.3",
  "svelte": "./build/index.js",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "svelte": "./build/index.js"
    }
  },
  "files": [
    "build"
  ],
  "private": false,
  "keywords": [
    "svelte",
    "magidoc",
    "browser",
    "marked",
    "markdown"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/magidoc-org/magidoc.git",
    "directory": "packages/plugins/svelte-marked"
  },
  "scripts": {
    "dev": "vite dev --port 5175",
    "build": "svelte-kit sync && svelte-package --output build",
    "test": "pnpm check",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "release": "pnpm publish --no-git-checks --access public"
  },
  "dependencies": {
    "github-slugger": "2.0.0",
    "marked": "18.1.3",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "8.0.0",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/package": "3.0.2",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.6",
    "@types/prismjs": "1.26.6",
    "svelte-check": "4.7.8",
    "tslib": "2.9.1",
    "typescript": "~6.0.3",
    "vite": "8.3.6"
  }
}
