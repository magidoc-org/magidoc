{
  "name": "@magidoc/plugin-fuse-markdown",
  "description": "A plugin used to index markdown text into a Fuse.js search engine.",
  "private": false,
  "version": "6.4.4",
  "type": "module",
  "license": "MIT",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "keywords": [
    "markdown",
    "marked",
    "fuse",
    "magidoc"
  ],
  "homepage": "https://magidoc-org.github.io/magidoc/plugins/fuse-markdown",
  "repository": {
    "type": "git",
    "url": "https://github.com/magidoc-org/magidoc.git",
    "directory": "packages/plugins/fuse-markdown"
  },
  "scripts": {
    "build": "run-p build:*",
    "build:rollup": "rollup -c",
    "build:tsc": "tsc --build tsconfig.build.json",
    "test": "vitest run --coverage",
    "release": "pnpm publish --no-git-checks --access public"
  },
  "dependencies": {
    "fuse.js": "7.4.2",
    "github-slugger": "2.0.0",
    "marked": "18.0.5"
  },
  "devDependencies": {
    "@types/node": "25.9.2",
    "@vitest/coverage-v8": "4.1.8",
    "rollup": "4.61.1",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "4.1.8"
  },
  "peerDependencies": {
    "fuse.js": "6.6.2"
  },
  "files": [
    "build"
  ]
}
