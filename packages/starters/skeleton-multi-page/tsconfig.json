{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "strict": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "#lib": ["./src/lib"],
      "#lib/*": ["./src/lib/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
