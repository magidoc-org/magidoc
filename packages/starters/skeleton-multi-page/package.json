{
  "name": "@magidoc/starter-skeleton-multi-page",
  "version": "8.0.3",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  },
  "keywords": [
    "svelte",
    "svelte-kit",
    "starter",
    "magidoc"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview",
    "test": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "devDependencies": {
    "@magidoc/plugin-fuse-graphql": "workspace:^",
    "@magidoc/plugin-fuse-markdown": "workspace:^",
    "@magidoc/plugin-query-generator": "workspace:^",
    "@magidoc/plugin-reverse-schema-mapper": "workspace:^",
    "@magidoc/plugin-starter-common": "workspace:^",
    "@magidoc/plugin-starter-variables": "workspace:^",
    "@magidoc/plugin-svelte-marked": "workspace:^",
    "@magidoc/plugin-svelte-prismjs": "workspace:^",
    "@magidoc/rollup-plugin-gql-schema": "workspace:^",
    "@skeletonlabs/skeleton": "5.0.4",
    "@skeletonlabs/skeleton-svelte": "5.0.4",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/lodash": "4.17.27",
    "@types/prismjs": "1.26.6",
    "carbon-icons-svelte": "13.18.0",
    "fuse.js": "7.5.0",
    "graphql": "17.1.0",
    "lodash": "4.18.1",
    "marked": "18.1.3",
    "marked-gfm-heading-id": "4.1.4",
    "prism-svelte": "0.5.0",
    "prismjs": "1.30.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "svelte-markdown": "0.4.1",
    "tailwindcss": "4.3.5",
    "tslib": "2.9.1",
    "typescript": "6.0.3",
    "vite": "8.3.6"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "github-slugger": "2.0.0"
  }
}
